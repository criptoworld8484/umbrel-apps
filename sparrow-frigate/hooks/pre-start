#!/bin/sh
set -eu

EXPECTED_NETWORK="${FRIGATE_NETWORK:-signet}"

if [ -n "${APP_BITCOIN_NETWORK:-}" ] && [ "${APP_BITCOIN_NETWORK}" != "${EXPECTED_NETWORK}" ]; then
  echo "ERROR (sparrow-frigate): Bitcoin está en '${APP_BITCOIN_NETWORK}', se requiere '${EXPECTED_NETWORK}'."
  echo "ERROR: En Bitcoin Node → Advanced → Signet, reinicia Bitcoin y luego esta app."
  exit 1
fi

echo "sparrow-frigate pre-start OK (bitcoin network: ${APP_BITCOIN_NETWORK:-unknown})."
