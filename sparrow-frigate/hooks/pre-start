#!/bin/sh
set -eu

BITCOIN_NETWORK="${APP_BITCOIN_NETWORK:-unknown}"
FRIGATE_NETWORK="${FRIGATE_NETWORK:-${APP_BITCOIN_NETWORK:-mainnet}}"

echo "sparrow-frigate pre-start: bitcoin=${BITCOIN_NETWORK}, frigate=${FRIGATE_NETWORK}"

DIR="$(dirname "$0")"
"${DIR}/sync-web-ui.sh" || true

echo "sparrow-frigate pre-start OK."
